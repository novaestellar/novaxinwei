# ============================================================
# NovaXinWei (新信微) — 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# === GitHub Dorks ===
# GitHub API 认证 (用于 dorks/github_dorks)
GH_USER=""
GH_PWD=""
GH_TOKEN=""
GH_URL=""

# === xAI Search (可选) ===
# XAI API 密钥 (用于 x_search)
XAI_API_KEY=""

# === Fetch Chain 行为 ===
# 自动安装 nodriver/patchright (0=关, 1=开)
NOVAXINWEI_AUTO_INSTALL=0

# 请求抖动 (毫秒, 默认 150-400)
NOVAXINWEI_JITTER_MS_MIN=150
NOVAXINWEI_JITTER_MS_MAX=400

# 禁用 session 池 (0=池化, 1=单次)
NOVAXINWEI_NO_SESSION_POOL=0

# === Learning 系统 ===
# 启用学习 (0=关, 1=开)
NOVAXINWEI_LEARN=1
# 学习数据 TTL (天, 默认 30)
NOVAXINWEI_LEARN_TTL_DAYS=30
# 学习数据最大条目数 (默认 500)
NOVAXINWEI_LEARN_MAX=500
# 自定义学习数据路径 (可选)
NOVAXINWEI_LEARNED_PATH=""

# === 安全 ===
# 允许私有地址访问 (0=关, 1=开, 仅本地测试!)
NOVAXINWEI_ALLOW_PRIVATE=0

# === Observations ===
# 自定义 observations 目录路径 (可选)
NOVAXINWEI_OBSERVATIONS_DIR=""

# === xAI Search 控制 ===
# xAI 搜索开关 (auto/on/off)
NOVAXINWEI_SEARCH_XAI=auto
