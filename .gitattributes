# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf diff=markdown
*.py text eol=lf diff=python
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.example text eol=lf
*.jsonl text eol=lf
*.svg text eol=lf

# Declare files that will always have CRLF on checkout
*.bat text eol=crlf
*.ps1 text eol=crlf

# Engagement runtime state must never be line-ending-normalised
engagements/** text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.bin binary
*.dat binary
*.exe binary
*.dll binary
*.so binary
*.xlsx binary

# Vendor / minified / generated - excluded from diffs and language stats
*.min.js linguist-generated=true -diff
*.min.css linguist-generated=true -diff
*.lock linguist-generated=true
